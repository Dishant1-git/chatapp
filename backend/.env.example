PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/chat-app

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the frontend runs (comma-separated if there are several). Used for CORS.
# Example: CLIENT_URL=https://your-app.vercel.app,http://localhost:3000
CLIENT_URL=http://localhost:3000

# Folder where uploaded images are stored
UPLOAD_DIR=uploads

# Calls: servers that help browsers connect to each other.
# STUN (free, defaults to Google's) works on most networks. Some mobile networks and
# strict firewalls need a TURN relay — get one from a provider (e.g. Metered, Twilio,
# Cloudflare) or run coturn, then fill these in.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ✉️ Email verification: the six-digit code new accounts have to type in.
# Free hosting blocks outbound SMTP, so this sends over HTTPS through Brevo
# (free: 300 emails a day, no card). Sign up at brevo.com, add your own address
# under Senders & IP and confirm it, then create an API key under SMTP & API.
# MAIL_FROM must be exactly the address you confirmed there.
# With these unset the code is printed in this server's log instead, which is
# what local development and the tests use.
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=you@gmail.com
# MAIL_FROM_NAME=Ghost-ed

# 💌 "People are waiting for you": someone who hasn't opened the app for two days
# gets one email saying who wrote to them (never what — it's encrypted). It needs
# the mail settings above and uses the first CLIENT_URL for its links. At most this
# many go out per hour, to leave room in Brevo's daily allowance; 0 switches it off.
# COME_BACK_MAILS_PER_HOUR=8

# 🚫 Temporary email services (mailinator, 10minutemail …) can't sign up; the list
# comes from the disposable-email-domains package. Add more here, comma-separated.
# BLOCKED_EMAIL_DOMAINS=example-temp.com,another.org

# Development only: new accounts skip email verification (used by the tests).
# Never set this on a real server.
# AUTO_VERIFY_EMAIL=1

# 🎞️ GIF search. Get a free key at developers.giphy.com (create an app, pick the Web SDK).
# Without it the app simply doesn't show the GIF tab; everything else works as normal.
# GIPHY_API_KEY=

# 👻 Boo, the ghost at the top of everyone's chat list. Boo's answers come from Grok:
# get a key at console.x.ai. Without it Boo still shows up, with a handful of
# built-in lines instead of real answers.
# GROK_MODEL is optional — set it if xAI has retired the default model.
# GROK_API_KEY=xai-...
# GROK_MODEL=grok-4-fast-non-reasoning

# 🎙️ Voice commands ("Hey Boo, call Harinder"). Kimi (Moonshot AI) works out what
# was asked: get a key at platform.moonshot.ai. Without it only the plainest
# commands ("call …", "message … saying …") are understood.
# KIMI_API_URL is for keys from the Chinese platform (https://api.moonshot.cn/v1);
# KIMI_MODEL picks a model instead of letting the server choose one the key has.
# KIMI_API_KEY=sk-...
# KIMI_API_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2.6

# 🔔 Push notifications: tells people's devices about new messages when the app
# isn't open. Generate a pair with: npx web-push generate-vapid-keys
# Without them the app simply doesn't show the notifications switch.
# VAPID_SUBJECT is a contact address push services can reach you on (defaults to MAIL_FROM).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@gmail.com

# Number of proxies in front of this server, so rate limiting sees the visitor's real IP.
# Leave unset when the frontend runs on the same machine; use 1 when it runs elsewhere.
# TRUST_PROXY=1

# Only needed if the browser calls this API on a different domain directly
# (not through the frontend). Then use: COOKIE_SAME_SITE=none (requires HTTPS)
# COOKIE_SAME_SITE=lax
